{
  "name": "apptemplatebase",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main/index.cjs",
  "workspaces": ["frontend"],
  "scripts": {
    "start": "node scripts/dev/bootstrap-start.cjs",
    "start:bootstrap-only": "node scripts/dev/bootstrap-start.cjs --bootstrap-only",
    "template:init": "node scripts/template/init-template.cjs --force",
    "template:init:check": "node scripts/template/init-template.cjs --dry-run",
    "setup:local-ai": "python3 -m tools.local_ai_setup setup:local-ai",
    "setup:whisper": "python3 -m tools.local_ai_setup setup:whisper",
    "setup:piper": "python3 -m tools.local_ai_setup setup:piper",
    "check:local-ai": "python3 -m tools.local_ai_setup check:local-ai",
    "stt:check": "python3 -m tools.local_ai_setup stt:check",
    "tts:check": "python3 -m tools.local_ai_setup tts:check",
    "dev": "npm run app:dev",
    "app:dev": "concurrently -k \"npm:frontend:dev\" \"npm:electron:dev\"",
    "frontend:dev": "npm --prefix frontend start",
    "electron:dev": "wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "electron:smoke": "npm run build:frontend && cross-env ELECTRON_DISABLE_SANDBOX=1 APP_TEMPLATE_SMOKE=1 APP_TEMPLATE_RENDERER_MODE=dist electron . --no-sandbox",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "package": "npm run build:frontend && echo \"Packaging is not configured yet.\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^31.7.7",
    "wait-on": "^8.0.5"
  }
}
