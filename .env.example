# Shared local defaults for the desktop app template.
# Copy this file to `.env` and adjust paths for the current machine.

# Application identity
APP_NAME=AppTemplateBase
APP_ENV=development
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Local data convention
# Keep runtime data under ./data by default and do not commit it.
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app_template_base.sqlite3
AUDIO_INPUT_DIR=./data/audio/input
TTS_OUTPUT_DIR=./data/audio/tts
LOG_DIR=./logs

# Local STT
WHISPER_CPP_BINARY=
WHISPER_MODEL_PATH=
WHISPER_THREAD_COUNT=4
KEEP_UPLOADED_AUDIO_FILES=true
DEFAULT_STT_MODEL=

# Local TTS
TTS_ENGINE=mock
PIPER_BINARY=
PIPER_MODEL_PATH=
