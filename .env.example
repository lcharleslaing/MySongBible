# Root-level shared defaults

# Application
APP_NAME=AppTemplateBase
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/app_template_base.sqlite3

# Local AI
WHISPER_CPP_BINARY=
WHISPER_MODEL_PATH=
WHISPER_THREAD_COUNT=4
KEEP_UPLOADED_AUDIO_FILES=true
DEFAULT_STT_MODEL=
TTS_ENGINE=mock
PIPER_BINARY=
PIPER_MODEL_PATH=
TTS_OUTPUT_DIR=./data/audio/tts

# Paths
APP_DATA_DIR=./data
LOG_DIR=./logs
