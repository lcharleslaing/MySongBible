# Shared local defaults for the desktop app template.
# Backend settings are loaded from backend/.env when FastAPI runs with backend/ as cwd.
# Copy backend/.env.example to backend/.env for backend-specific configuration.

# Application identity
APP_NAME=AppTemplateBase
APP_ENV=development
LOG_LEVEL=INFO

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,file://,null

# Local data convention
# Keep runtime data under ./data by default and do not commit it.
APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app_template_base.sqlite3
AUDIO_INPUT_DIR=./data/audio/input
TTS_OUTPUT_DIR=./data/audio/tts
LOG_DIR=./logs

# Local STT
WHISPER_CPP_BINARY=
WHISPER_MODEL_PATH=
WHISPER_THREAD_COUNT=4
WHISPER_TIMEOUT_SECONDS=120
KEEP_UPLOADED_AUDIO_FILES=true
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,flac,m4a,webm
ALLOWED_AUDIO_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/ogg,audio/flac,audio/x-flac,audio/mp4,audio/m4a,audio/webm
DEFAULT_STT_MODEL=

# Local TTS
TTS_ENGINE=mock
PIPER_BINARY=
PIPER_MODEL_PATH=
TTS_TIMEOUT_SECONDS=120
