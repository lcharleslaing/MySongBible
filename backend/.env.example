# Backend-specific local defaults.
# Copy to backend/.env only if you need backend-only overrides.

APP_NAME=Video Creator Backend
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=../logs

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,file://,null

APP_DATA_DIR=./data
LOCAL_AI_HOME=
# Startup-only. Change this in backend/.env and restart the backend; it is not changed at runtime by the Settings UI.
DATABASE_URL=sqlite:///./data/app_template_base.sqlite3
DATABASE_ECHO=false
AUDIO_INPUT_DIR=./data/audio/input
TTS_OUTPUT_DIR=./data/audio/tts

WHISPER_CPP_BINARY=
WHISPER_MODEL_PATH=
# First-run template initialization may write local defaults to backend/.env:
# WHISPER_CPP_BINARY=/home/llaing/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH prefers:
#   /home/llaing/whisper.cpp/models/ggml-tiny.en.bin
#   /home/llaing/whisper.cpp/models/ggml-base.en.bin
#   /home/llaing/whisper.cpp/models/ggml-small.en.bin
WHISPER_THREAD_COUNT=4
WHISPER_TIMEOUT_SECONDS=120
KEEP_UPLOADED_AUDIO_FILES=true
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,flac,m4a,webm
ALLOWED_AUDIO_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/ogg,audio/flac,audio/x-flac,audio/mp4,audio/m4a,audio/webm

# Backward-compatible aliases if needed:
# WHISPER_CPP_PATH=
# WHISPER_MODEL_DIR=

DEFAULT_STT_MODEL=
TTS_ENGINE=mock
PIPER_BINARY=
PIPER_MODEL_PATH=
TTS_TIMEOUT_SECONDS=120
