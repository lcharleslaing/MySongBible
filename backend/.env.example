# Backend-specific defaults

APP_NAME=AppTemplateBase Backend
APP_ENV=development
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app_template_base.sqlite3
DATABASE_ECHO=false

WHISPER_CPP_BINARY=
WHISPER_MODEL_PATH=
WHISPER_THREAD_COUNT=4
KEEP_UPLOADED_AUDIO_FILES=true

# Backward-compatible aliases if needed:
# WHISPER_CPP_PATH=
# WHISPER_MODEL_DIR=

DEFAULT_STT_MODEL=
DEFAULT_TTS_ENGINE=placeholder
